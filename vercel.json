{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/posts/(predileto|davin)/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/posts/(astro-paper-2|astro-paper-v3|astro-paper-v4|astro-paper-v5)(/.*)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/categories/(software-development|personal-projects|software-management|others)(/.*)?",
      "destination": "/categories/",
      "permanent": false
    }
  ]
}
