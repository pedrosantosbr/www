---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostLog from "@/components/PostLog.astro";
import Pagination from "@/components/Pagination.astro";
import { CATEGORIES } from "@/content.config";
import { slugifyStr } from "@/utils/slugify";
import getPostsByCategory from "@/utils/getPostsByCategory";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  // every active category gets a page, even before it has posts
  return CATEGORIES.flatMap(category => {
    const categorySlug = slugifyStr(category);
    const categoryPosts = getPostsByCategory(posts, category);

    return paginate(categoryPosts, {
      params: { category: categorySlug },
      props: { categoryName: category },
      pageSize: SITE.postPerPage,
    });
  });
}

const { category } = Astro.params;
const { page, categoryName } = Astro.props;
---

<Layout title={`Category: ${categoryName} | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle={[`Category:`, `${categoryName}`]}
    titleTransition={category}
    pageDesc={`All the articles in the "${categoryName}" category.`}
  >
    <h1 slot="title" transition:name={category}>{`Category:${category}`}</h1>
    <PostLog posts={page.data} />
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
