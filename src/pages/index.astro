---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import PostLog from "@/components/PostLog.astro";
import FocusLine from "@/components/FocusLine.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { Image } from "astro:assets";
import profile from "@/assets/images/pedro-profile.png";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const latestPosts = getSortedPosts(posts).slice(0, SITE.postPerIndex);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section
      id="hero"
      class="flex flex-col items-center pt-[clamp(40px,8vw,96px)] pb-[clamp(32px,5vw,56px)] text-center"
    >
      <Image
        src={profile}
        alt={SITE.title}
        width={224}
        height={224}
        loading="eager"
        fetchpriority="high"
        class="size-28 rounded-full border border-rule object-cover object-[50%_30%] p-1"
      />
      <p class="mt-6 font-sans text-[17px] text-soft">{SITE.title}</p>
      <h1 class="mt-1 font-serif text-[clamp(40px,6vw,56px)] leading-[1.05] font-bold tracking-[-0.015em] text-ink">
        Builder.
      </h1>
      <FocusLine class="mt-6" />
      {SOCIALS.length > 0 && (
        <div class="mt-7">
          <Socials variant="boxed" />
        </div>
      )}
    </section>

    <section id="latest-posts" class="border-t border-rule pt-10 pb-6">
      <h2 class="label mb-3 text-[11.5px] tracking-[0.1em]">Latest posts</h2>
      <PostLog posts={latestPosts} />
      {latestPosts.length > 0 && (
        <div class="my-6 text-end">
          <a href="/posts/" class="label no-underline hover:text-ink">
            All posts ▸
          </a>
        </div>
      )}
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
