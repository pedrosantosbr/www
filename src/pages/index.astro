---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import PostLog from "@/components/PostLog.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
// const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section
      id="hero"
      class="pt-[clamp(34px,7vw,88px)] pb-[clamp(26px,4vw,40px)]"
    >
      <p class="label mb-4 text-[11.5px] tracking-[0.1em]">
        {SITE.title} · Notes
      </p>
      <h1 class="font-serif text-title font-bold tracking-(--text-title--letter-spacing) text-ink">
        Welcome to my personal blog.
      </h1>
      <p class="mt-4 max-w-[34em] font-serif text-read text-soft">
        Writing about building products, software design and the things I learn
        along the way. Feel free to snoop around.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
        <a
          target="_blank"
          href="/rss.xml"
          class="label inline-flex items-center gap-1.5 rounded-[3px] border border-rule px-2 py-1 no-underline hover:border-ink hover:text-ink"
          title="RSS Feed"
        >
          <IconRss class="size-3.5 stroke-current stroke-2" />
          RSS
        </a>
        {SOCIALS.length > 0 && <Socials />}
      </div>
    </section>

    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-4 pb-6">
        <h2 class="label mb-3 text-[11.5px] tracking-[0.1em]">Recent posts</h2>
        <PostLog posts={recentPosts.slice(0, SITE.postPerIndex)} />
      </section>
    )}

    <div class="my-6 text-end">
      <a href="/posts/" class="label no-underline hover:text-ink">
        All posts ▸
      </a>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
