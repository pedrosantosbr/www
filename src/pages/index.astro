---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import PostLog from "@/components/PostLog.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { Image } from "astro:assets";
import profile from "@/assets/images/pedro-profile.png";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const FOCUS = ["AI", "Healthcare", "Data"];

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
// const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section
      id="hero"
      class="flex flex-col items-center pt-[clamp(40px,8vw,96px)] pb-[clamp(32px,5vw,56px)] text-center"
    >
      <Image
        src={profile}
        alt={SITE.title}
        width={224}
        height={224}
        loading="eager"
        fetchpriority="high"
        class="size-28 rounded-full border border-rule object-cover object-[50%_30%] p-1"
      />
      <p class="mt-6 font-sans text-[17px] text-soft">{SITE.title}</p>
      <h1 class="mt-1 font-serif text-[clamp(40px,6vw,56px)] leading-[1.05] font-bold tracking-[-0.015em] text-ink">
        Builder.
      </h1>
      <p class="label mt-6 flex items-center gap-3 border-y border-rule px-1 py-2.5 text-[12.5px] tracking-[0.18em]">
        {FOCUS.map((item, i) => (
          <>
            {i > 0 && (
              <span aria-hidden="true" class="text-accent">
                •
              </span>
            )}
            <span>{item}</span>
          </>
        ))}
      </p>
      {SOCIALS.length > 0 && (
        <div class="mt-7">
          <Socials variant="boxed" />
        </div>
      )}
    </section>

    {recentPosts.length > 0 && (
      <section id="recent-posts" class="border-t border-rule pt-10 pb-6">
        <h2 class="label mb-3 text-[11.5px] tracking-[0.1em]">Recent posts</h2>
        <PostLog posts={recentPosts.slice(0, SITE.postPerIndex)} />
        <div class="my-6 text-end">
          <a href="/posts/" class="label no-underline hover:text-ink">
            All posts ▸
          </a>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
