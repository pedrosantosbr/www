---
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

type StringTitle = { pageTitle: string };
type ArrayTitle = { pageTitle: [string, string]; titleTransition: string };

type Props = (StringTitle | ArrayTitle) & { pageDesc?: string };

const { props } = Astro;

const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";

const titleClass =
  "font-serif text-[clamp(30px,4.2vw,46px)] leading-[1.12] font-bold tracking-[-0.012em] text-ink";
---

<Breadcrumb />
<main data-backUrl={backUrl} id="main-content" class="app-layout pb-4">
  {"titleTransition" in props ? (
    <h1 class={titleClass}>
      {props.pageTitle[0]}
      <span transition:name={props.titleTransition}>{props.pageTitle[1]}</span>
    </h1>
  ) : (
    <h1 class={titleClass}>{props.pageTitle}</h1>
  )}
  {props.pageDesc && (
    <p class="mt-3 font-sans text-ui text-soft">{props.pageDesc}</p>
  )}
  <div class="mt-[clamp(24px,4vw,40px)]">
    <slot />
  </div>
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
