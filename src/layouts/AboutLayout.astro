---
import type { MarkdownLayoutProps } from "astro";
import { Image } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Socials from "@/components/Socials.astro";
import FocusLine from "@/components/FocusLine.astro";
import profile from "@/assets/images/pedro-profile.png";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = MarkdownLayoutProps<{ title: string }>;

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <header class="border-b border-rule pb-[clamp(26px,4vw,40px)]">
      <h1 class="sr-only">{frontmatter.title}</h1>
      <div class="flex items-center gap-5">
        <Image
          src={profile}
          alt={SITE.title}
          width={176}
          height={176}
          loading="eager"
          class="size-[88px] shrink-0 rounded-full border border-rule object-cover object-[50%_30%] p-1"
        />
        <div>
          <p class="font-sans text-[17px] text-soft">{SITE.title}</p>
          <p class="font-serif text-[clamp(34px,5vw,46px)] leading-[1.05] font-bold tracking-[-0.015em] text-ink">
            Builder.
          </p>
        </div>
      </div>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
        <FocusLine />
        <Socials variant="boxed" />
      </div>
    </header>
    <section id="about" class="app-prose mb-28 pt-[clamp(28px,4vw,44px)]">
      <slot />
    </section>
  </main>
  <Footer />
</Layout>
