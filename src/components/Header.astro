---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const links = [
  { href: "/posts", label: "Posts" },
  { href: "/tags", label: "Tags" },
  { href: "/categories", label: "Categories" },
  ...(SITE.showArchives ? [{ href: "/archives", label: "Archives" }] : []),
  { href: "/about", label: "About" },
];

const ctlClass =
  "inline-flex h-7 w-[31px] items-center justify-center rounded-[3px] border border-rule text-subtle hover:text-ink [&>svg]:size-4";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="label absolute start-4 -top-full z-50 bg-ground px-3 py-2 text-accent transition-all focus:top-4"
>
  Skip to content
</a>

<header
  id="site-header"
  class="relative mx-auto flex w-full max-w-wrap flex-wrap items-center gap-x-4 gap-y-2 px-4 pt-4 pb-3"
>
  <a
    href="/"
    class="me-auto font-sans text-sm font-extrabold tracking-[0.03em] whitespace-nowrap text-ink uppercase no-underline"
  >
    {SITE.title}
  </a>

  <nav
    aria-label="Site"
    class="order-last -ms-2 flex w-full flex-wrap gap-0.5 sm:order-none sm:ms-0 sm:w-auto"
  >
    {links.map(({ href, label }) => (
      <a
        href={href}
        aria-current={isActive(href) ? "page" : undefined}
        class:list={[
          "rounded-[3px] px-2 py-0.5 font-mono text-[13px] tracking-[0.02em] no-underline",
          isActive(href) ? "bg-ink text-ground" : "text-subtle hover:text-ink",
        ]}
      >
        {label}
      </a>
    ))}
  </nav>

  <div class="flex items-center gap-1.5">
    <a
      href="/search"
      class:list={[ctlClass, { "text-ink": isActive("/search") }]}
      title="Search"
      aria-label="Search"
    >
      <IconSearch />
    </a>
    {SITE.lightAndDarkMode && (
      <button
        id="theme-btn"
        class:list={[ctlClass, "relative"]}
        title="Toggles light & dark"
        aria-label="auto"
        aria-live="polite"
      >
        <IconMoon class="absolute dark:hidden" />
        <IconSunHigh class="absolute hidden dark:block" />
      </button>
    )}
  </div>
</header>
