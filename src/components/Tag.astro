---
type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "inline-block rounded-[2px] border border-rule bg-sheet font-mono text-subtle no-underline",
      "hover:border-ink hover:text-ink",
      size === "sm" ? "px-2 py-0.5 text-[12px]" : "px-2.5 py-1 text-[14px]",
    ]}
  >
    #{tagName}
  </a>
</li>
