---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-wrap items-center gap-0.5">
  {SOCIALS.map(social => (
    <LinkButton
      href={social.href}
      class="p-1.5 text-subtle"
      title={social.linkTitle}
    >
      <social.icon class="inline-block size-[18px] fill-transparent stroke-current stroke-2 group-hover:fill-transparent" />
      <span class="sr-only">{social.linkTitle}</span>
    </LinkButton>
  ))}
</div>
