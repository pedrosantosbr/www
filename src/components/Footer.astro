---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { SITE } from "@/config";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const links = [
  { href: "/", label: "Home" },
  { href: "/posts/", label: "Posts" },
  { href: "/tags/", label: "Tags" },
  { href: "/categories/", label: "Categories" },
  { href: "/about/", label: "About" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer
  class:list={[
    "mx-auto w-full max-w-wrap px-4",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="mt-12 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-rule pt-4 pb-6 sm:mt-20">
    <nav aria-label="Footer" class="-ms-2 flex flex-wrap gap-0.5">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class="px-2 py-0.5 font-mono text-[13px] tracking-[0.02em] text-subtle no-underline hover:text-ink"
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <span class="label normal-case">
        © {currentYear} {SITE.title}
      </span>
      <Socials />
    </div>
  </div>
</footer>
