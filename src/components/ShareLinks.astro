---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

{SHARE_LINKS.length > 0 && (
  <div class="flex items-center gap-1">
    <span class="label me-1">Share</span>
    {SHARE_LINKS.map(social => (
      <LinkButton
        href={`${social.href + URL}`}
        class="p-1 text-subtle"
        title={social.linkTitle}
      >
        <social.icon class="inline-block size-[18px] fill-transparent stroke-current stroke-2 group-hover:fill-transparent" />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))}
  </div>
)}
