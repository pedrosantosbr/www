---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;

const linkClass =
  "rounded-[3px] border border-rule px-2.5 py-1 no-underline hover:border-ink hover:text-ink";
---

{page.lastPage > 1 && (
  <nav
    class="label mx-auto mt-10 mb-8 flex w-full max-w-measure items-center justify-between px-4"
    aria-label="Pagination Navigation"
  >
    {page.url.prev ? (
      <a href={page.url.prev} class={linkClass} aria-label="Goto Previous Page">
        ◂ Newer
      </a>
    ) : (
      <span class="px-2.5 py-1 opacity-40">◂ Newer</span>
    )}
    <span class="tabular-nums">
      Page {page.currentPage} / {page.lastPage}
    </span>
    {page.url.next ? (
      <a href={page.url.next} class={linkClass} aria-label="Goto Next Page">
        Older ▸
      </a>
    ) : (
      <span class="px-2.5 py-1 opacity-40">Older ▸</span>
    )}
  </nav>
)}
