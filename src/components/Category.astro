---
type Props = {
  category: string;
  categorySlug: string;
  size?: "sm" | "lg";
};

const { category, categorySlug, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/categories/${categorySlug}/`}
    transition:name={categorySlug}
    class:list={[
      "inline-block rounded-[2px] border border-rule bg-sheet font-mono text-subtle no-underline",
      "hover:border-ink hover:text-ink",
      size === "sm" ? "px-2 py-0.5 text-[12px]" : "px-2.5 py-1 text-[14px]",
    ]}
  >
    {category}
  </a>
</li>
