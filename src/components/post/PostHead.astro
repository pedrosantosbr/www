---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import tzPlugin from "dayjs/plugin/timezone";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(tzPlugin);

type Props = {
  title: string;
  pubDatetime: Date;
  modDatetime?: Date | null;
  timezone?: string;
  minutes: number;
  category: string;
};

const { title, pubDatetime, modDatetime, timezone, minutes, category } =
  Astro.props;

const tz = timezone || SITE.timezone;
const fmt = (d: Date) => dayjs(d).tz(tz);
const published = fmt(pubDatetime);
const updated =
  modDatetime && modDatetime > pubDatetime ? fmt(modDatetime) : null;

const meta = [
  {
    label: "Published",
    value: published.format("D MMMM YYYY"),
    datetime: published.toISOString(),
  },
  ...(updated
    ? [
        {
          label: "Updated",
          value: updated.format("D MMMM YYYY"),
          datetime: updated.toISOString(),
        },
      ]
    : []),
  { label: "Reading time", value: `${minutes} min` },
];
---

<header class="border-b border-rule pt-[clamp(34px,6vw,76px)] pb-[clamp(26px,4vw,40px)]">
  <h1
    id="post-title"
    transition:name={slugifyStr(title.replaceAll(".", "-"))}
    class="font-serif text-title font-bold tracking-(--text-title--letter-spacing) text-ink"
  >
    {title}
  </h1>
  <dl class="mt-[clamp(22px,3vw,32px)] grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-x-6 gap-y-4">
    {meta.map(({ label, value, datetime }) => (
      <div>
        <dt class="label mb-1.5 text-[11.5px] tracking-[0.1em]">{label}</dt>
        <dd class="meta-dd">
          {datetime ? <time datetime={datetime}>{value}</time> : value}
        </dd>
      </div>
    ))}
    <div>
      <dt class="label mb-1.5 text-[11.5px] tracking-[0.1em]">Category</dt>
      <dd class="meta-dd">
        <a
          href={`/categories/${slugifyStr(category)}/`}
          transition:name={slugifyStr(category)}
          class="underline decoration-rule underline-offset-[0.18em] hover:decoration-accent"
        >
          {category}
        </a>
      </dd>
    </div>
  </dl>
</header>

<style>
  @reference "@/styles/global.css";
  .meta-dd {
    @apply m-0 flex gap-[0.7ch] font-sans text-ui leading-[1.4] text-ink;
    &::before {
      content: "└";
      @apply font-mono text-subtle;
    }
  }
</style>
