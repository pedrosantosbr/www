---
import type { CollectionEntry } from "astro:content";
import Tag from "@/components/Tag.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import EditPost from "@/components/EditPost.astro";
import { slugifyStr } from "@/utils/slugify";

type Neighbour = { href: string; title: string } | null;

type Props = {
  post: CollectionEntry<"blog">;
  newer: Neighbour;
  older: Neighbour;
};

const { post, newer, older } = Astro.props;
const { tags, hideEditPost } = post.data;

const more = [
  newer && { kind: "Newer", ...newer },
  older && { kind: "Older", ...older },
  { kind: "All", href: "/posts/", title: "Every post" },
].filter(Boolean) as { kind: string; href: string; title: string }[];
---

<footer data-pagefind-ignore class="mt-12">
  <div class="label text-center tracking-[0.2em]">— End —</div>

  <div class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-4 border-y border-rule py-4">
    <ul class="flex flex-wrap gap-2">
      {tags.map(tag => (
        <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
      ))}
    </ul>
    <div class="flex items-center gap-4">
      <EditPost {hideEditPost} {post} />
      <ShareLinks />
    </div>
  </div>

  <nav aria-label="More posts" class="mt-10">
    <span class="label mb-2 block text-[11.5px] tracking-[0.1em]">
      More posts
    </span>
    <ul>
      {more.map(({ kind, href, title }) => (
        <li class="border-b border-rule">
          <a
            href={href}
            class="-mx-2.5 grid grid-cols-[8ch_1fr] items-baseline gap-3 rounded-[3px] px-2.5 py-3 no-underline hover:bg-sheet"
          >
            <span class="font-mono text-label tracking-[0.06em] text-accent uppercase">
              {kind}
            </span>
            <span class="font-sans text-base text-ink">{title}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</footer>
